# Hướng dẫn cấu hình: Mở file này bằng Notepad để sửa thông tin

# =========================================================
# CHỌN PROVIDER BẠN MUỐN SỬ DỤNG (Xóa dấu # ở MỘT lựa chọn duy nhất)
# =========================================================
# PROVIDER=anthropic
# PROVIDER=gemini
# PROVIDER=openai
# PROVIDER=deepseek

# =========================================================
# TÙY CHỌN 1: ANTHROPIC / 9ROUTER
# =========================================================
ANTHROPIC_BASE_URL=http://127.0.0.1:20128/v1
ANTHROPIC_MODEL=High
ANTHROPIC_API_KEY=your_anthropic_token_here

# =========================================================
# TÙY CHỌN 2: GEMINI (Lấy key tại: aistudio.google.com)
# =========================================================
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# =========================================================
# TÙY CHỌN 3: OPENAI (Lấy key tại: platform.openai.com)
# =========================================================
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here

# =========================================================
# TÙY CHỌN 4: DEEPSEEK (Lấy key tại: platform.deepseek.com)
# =========================================================
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=your_deepseek_api_key_here

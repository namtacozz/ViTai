# Hướng dẫn cấu hình: Mở file này bằng Notepad để sửa thông tin

# =========================================================
# TÙY CHỌN 1: NẾU BẠN DÙNG PROXY NỘI BỘ (như 9Router)
# =========================================================
ANTHROPIC_BASE_URL=http://127.0.0.1:20128/v1
ANTHROPIC_DEFAULT_SONNET_MODEL=High

# =========================================================
# TÙY CHỌN 2: NẾU BẠN DÙNG API GỐC CỦA ANTHROPIC 
# (Xóa dấu # ở 2 dòng dưới và thêm dấu # ở 2 dòng trên)
# =========================================================
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-3-5-sonnet-20241022

# =========================================================
# ĐIỀN API KEY HOẶC TOKEN CỦA BẠN VÀO ĐÂY:
# =========================================================
ANTHROPIC_AUTH_TOKEN=your_token_here
